	keywords = {Pariwisata},
	pages = {65--70},
	file = {Full Text PDF:/home/adi/Zotero/storage/R4QAB5P9/Sari and Triyono - 2025 - Optimalisasi Copywriting Berbasis Kecerdasan Buatan untuk Meningkatkan Daya Tarik Pariwisata Desa Po.pdf:application/pdf},
