@article{syahrohim_pengukuran_2026,
	title = {Pengukuran {Usability} {Aplikasi} {Web} {Menggunakan} {Sus} (system {Usability} {Scale}) {Dan} {Pengujian} {Black} {Box} {Pada} {Website} {Iconplus}-{Warehouse}},
	volume = {14},
	copyright = {Copyright (c) 2026 Jurnal Informatika dan Teknik Elektro Terapan},
	issn = {2830-7062},
	url = {https://journal.eng.unila.ac.id/index.php/jitet/article/view/8193},
	doi = {10.23960/jitet.v14i1.8193},
	abstract = {Penelitian ini bertujuan untuk melakukan analisis terpadu dengan membandingkan hasil pengujian fungsional teknis (Black Box Testing) dengan persepsi subjektif pengguna (System Usability Scale - SUS) pada aplikasi web IconPlus-Warehouse. Aplikasi ini krusial dalam mengoptimalkan operasional logistik, khususnya untuk proses penerimaan dan pengeluaran barang. Pengujian teknis menggunakan teknik Equivalence Partitioning dan Boundary Value Analysis pada fitur utama menunjukkan bahwa semua skenario uji mendapatkan status PASS. Sementara itu, pengukuran usability menggunakan instrumen SUS dengan 15 responden menghasilkan Skor SUS Akhir 92,5. Skor ini termasuk dalam kategori Excellent, mengindikasikan bahwa secara fungsional aplikasi bekerja sesuai spesifikasi dan secara substansial dipersepsikan oleh pengguna sebagai sistem yang sangat baik dan dapat diterima. Analisis gabungan ini mengonfirmasi bahwa fitur yang berfungsi dengan baik secara teknis juga dianggap mudah digunakan oleh pengguna.},
	language = {en},
	number = {1},
	urldate = {2026-07-16},
	journal = {Jurnal Informatika dan Teknik Elektro Terapan},
	author = {Syahrohim, Imam and Parhusip, Jadiaman},
	month = jan,
	year = {2026},
	keywords = {System Usability Scale (SUS), Usability, Black Box Testing, IconPlus-Warehouse., Web Application},
	file = {Full Text PDF:/home/adi/Zotero/storage/82NWMYIY/Syahrohim and Parhusip - 2026 - Pengukuran Usability Aplikasi Web Menggunakan Sus (system Usability Scale) Dan Pengujian Black Box P.pdf:application/pdf},
}

