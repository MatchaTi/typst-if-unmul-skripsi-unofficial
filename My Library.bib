@article{muhajir_implementasi_2025,
	title = {Implementasi {Chatbot} {Menggunakan} {Framework} {Langchain} {Berbasis} {Llm} {Gpt}:},
	volume = {9},
	copyright = {Copyright (c) 2025 JATI (Jurnal Mahasiswa Teknik Informatika)},
	issn = {2598-828X},
