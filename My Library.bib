@article{maulida_pengujian_2025,
	title = {Pengujian {Black} {Box} {Testing} {Pada} {Sistem} {Website} {Pemesanan} {Online} {Toko} {Ayam} {Krispy}},
	volume = {3},
	copyright = {https://creativecommons.org/licenses/by-sa/4.0},
	issn = {3031-5220},
	url = {https://jurnal.mediaakademik.com/index.php/jma/article/view/1908},
	doi = {10.62281/v3i5.1908},
	abstract = {Perkembangan teknologi informasi yang pesat telah merambah ke berbagai sektor bisnis, termasuk industri kuliner. Salah satu inovasi yang signifikan adalah pengembangan website pemesanan online, yang memudahkan pelanggan dalam melakukan pemesanan makanan tanpa harus datang langsung ke lokasi. Penelitian ini bertujuan untuk menganalisis penerapan metode Black Box Testing dalam proses pengujian website pemesanan online untuk bisnis Toko Ayam Krispi. Metode Black Box Testing dipilih karena berfokus pada pengujian fungsionalitas sistem dari perspektif pengguna akhir tanpa memperhatikan struktur internal kode program. Pengujian dilakukan terhadap seluruh fitur fungsional website, meliputi registrasi pengguna, proses login, pencarian produk, keranjang belanja, proses checkout, hingga konfirmasi pesanan. Hasil penelitian menunjukkan bahwa penerapan metode ini berhasil mengidentifikasi kesalahan fungsional pada tahap awal pengembangan website, sehingga memungkinkan perbaikan dilakukan sebelum sistem dirilis ke pengguna. Kesimpulan dari penelitian ini menunjukkan bahwa Black Box Testing merupakan metode yang efektif dalam menjamin kualitas website pemesanan online Toko Ayam Krispi, khususnya dalam aspek fungsionalitas. Dengan pendekatan pengujian yang sistematis, potensi kesalahan dalam sistem dapat diminimalisir, sehingga menghasilkan platform yang lebih handal, efisien, dan memuaskan bagi pelanggan serta pelaku bisnis.},
	language = {id},
	number = {5},
	urldate = {2026-07-15},
	journal = {Jurnal Media Akademik (JMA)},
	author = {Maulida, Miftakhul and Zahro, Fithrotuz and Hakim, Rizqiyah and Muhammad Sonhaji Akbar, S. Pd},
	month = may,
	year = {2025},
	keywords = {Aplikasi Web, Ayam Krispi, Black Box Testing, Pemesanan Online},
	pages = {2--12},
	file = {Full Text PDF:/home/adi/Zotero/storage/3PS9BFP8/Maulida et al. - 2025 - Pengujian Black Box Testing Pada Sistem Website Pemesanan Online Toko Ayam Krispy.pdf:application/pdf},
}

@article{maulana_black_2023,
	title = {A {Black} {Box} {Testing} {Dengan} {Teknik} {Equivalence} {Partitions} {Pada} {Website} {Dinas} {Pengendalian} {Penduduk} {Dan} {Keluarga} {Berencana} {Karawang}},
	volume = {6},
	issn = {2622-6375},
	url = {https://ejournal.lppm-unbaja.ac.id/index.php/jsii/article/view/2536},
	doi = {10.47080/simika.v6i2.2536},
	abstract = {Website testing is the verification phase whether the website is working properly or not. If there are still errors, they must be corrected so that the website created reaches its goals and is of good quality. The website of the Department of Population Control and Family Planning (DPPKB) of Karawang Regency is being tested. With the name of the website, namely kbinten.id, this website is the official website of the Karawang Regency DPPKB which is used as a place for information about family planning programs in Karawang Regency, which is web-based for the community and consists of two parts, namely the website as an administrative panel and based on the website used by the username. Testing is conducted on a black box utilizing the Equivalence Partitions method. Black box testing allows for an external assessment of the program's functionality without knowledge of the underlying code. The Equivalence Partitions technique is employed to validate data inputted into various forms or pages on the kbinten.id website. Each input value is systematically examined and categorized into test cases yielding either valid or invalid outcomes. The objective of testing on kbinten.id is to identify and rectify implementation errors promptly, thereby expediting the error correction process.},
	language = {en},
	number = {2},
	urldate = {2026-07-15},
	journal = {Jurnal Sistem Informasi dan Informatika (Simika)},
	author = {Maulana, Taufik and Voutama, Apriade},
	month = aug,
	year = {2023},
	keywords = {Black Box, Equivalence Partitions, kbinten.id, Testing},
	pages = {112--121},
	file = {Full Text PDF:/home/adi/Zotero/storage/8TXPVK6F/Maulana and Voutama - 2023 - A Black Box Testing Dengan Teknik Equivalence Partitions Pada Website Dinas Pengendalian Penduduk Da.pdf:application/pdf},
}

