@article{ulumiyyah_named_2024,
	title = {Named {Entity} {Recognition} {Using} {Conditional} {Random} {Fields} for {Flood} {Detection} {In} {Gerbang} {Kertosusila} {Based} {Twitter} {Data}},
	volume = {7},
	copyright = {Copyright (c) 2024 Indonesian Journal of Artificial Intelligence and Data Mining},
	issn = {2614-6150},
	url = {https://ejournal.uin-suska.ac.id/index.php/IJAIDM/article/view/27062},
	doi = {10.24014/ijaidm.v7i2.27062},
	abstract = {The national strategic area Gerbang Kertosusila East Java should be aware of floods. One of the existing efforts is to place flood sensors at several flood-prone points. However, that way is constrained by the need for more equipment to handle the many needy areas. So it is necessary to develop technology for the dissemination of flood information. Dissemination of flood information was quickly obtained from social media Twitter. One way is to use Twitter's text data source for a Named Entity Recognition model to help detect flood events and their locations. The Named Entity Recognition (NER) model was constructed using the Conditional Random Fields (CRFs) method to achieve research objectives. This research adds slang word handling at the preprocessing stage to improve model performance and the use of the BIO format in the labeling process and POS Tagging in the Feature Extraction process. Evaluation results with five Kfolds, 80\% training data, and 20\% test data show that the NER CRFs model performs excellently with a Precision of 0.981, Recall of 0.926, and f-measure of 0.950 so that these results can help the community and government regarding the information on the distribution of floods.},
	language = {en},
	number = {2},
	urldate = {2026-04-21},
	journal = {Indonesian Journal of Artificial Intelligence and Data Mining},
	author = {Ulumiyyah, Ikrimatul and Rolliawati, Dwi and Izzuddin, Andik and Khalid, Khalid and Khunaefi, Anang and Ridwan, Mujib},
	month = may,
	year = {2024},
	keywords = {Conditional Random Fields, Named Entity Recognition, Natural Language Processing, Flood Detection, Gerbang Ketosusila},
	pages = {337--347},
	file = {Full Text PDF:/home/adi/Zotero/storage/9FDBQ2JH/Ulumiyyah et al. - 2024 - Named Entity Recognition Using Conditional Random Fields for Flood Detection In Gerbang Kertosusila.pdf:application/pdf},
}

