@article{islam_sosialisasi_2025,
	title = {Sosialisasi {Digital} {Marketing} {Serta} {Pembuatan} {Linktree} dan {Instagram} {Guna} {Meningkatkan} {Penjualan} di {UMKM} {Kopi} {Mbah} {Bongso}},
	volume = {3},
	issn = {2964-1993},
	url = {https://ukitoraja.id/index.php/jnb/article/view/556},
	doi = {10.59024/jnb.v3i1.556},
	abstract = {This project is motivated by the great potential of coffee as a product that is in demand, especially in the local environment of Babadan Village, Ngajum District, Malang Regency. However, UMKM Kopi Mbah Bongso has difficulty marketing its products online due to lack of knowledge about digital marketing and social media platforms. The methods used in this project are interviews and observations to understand the problems faced by UMKM Kopi Mbah Bongso. The results show that UMKM Kopi Mbah Bongso needs a better understanding of digital marketing and social media platforms to increase their sales. The solutions provided are digital marketing socialization, Linktree creation, and new Instagram account creation. Digital marketing socialization provides UMKM Kopi Mbah Bongso employees with an understanding of effective digital marketing strategies. Linktree creation makes it easier for consumers to access various links belonging to UMKM Kopi Mbah Bongso, such as social media profiles, websites, online stores, and other content. Creating a new Instagram account helps increase brand awareness and makes it easier for MSME Kopi Mbah Bongso to market their products online. This project has succeeded in increasing the understanding of MSME Kopi Mbah Bongso employees about digital marketing and social media platforms. This is expected to increase sales and operational efficiency of MSME Kopi Mbah Bongso.},
	language = {en},
	number = {1},
	urldate = {2026-06-17},
	journal = {Jurnal Nusantara Berbakti},
	author = {Islam, Aisyah Dwi Aulia},
	month = jan,
	year = {2025},
	keywords = {Community Empowerment, Digital Marketing, Social Media Platforms},
	pages = {147--153},
	file = {Full Text PDF:/home/adi/Zotero/storage/RZQYIDSX/Islam - 2025 - Sosialisasi Digital Marketing Serta Pembuatan Linktree dan Instagram Guna Meningkatkan Penjualan di.pdf:application/pdf},
}

@article{hanantyo_pengembangan_2024,
	title = {Pengembangan {Platform} {E}-{Commerce} {Berbasis} {Web} {Dalam} {Rangka} {Meningkatkan} {Daya} {Saing} {Umkm} {Kabupaten} {Rembang}},
	volume = {11},
	copyright = {Copyright (c) 2024 Jurnal Abdi Insani},
	issn = {2828-3155},
	url = {https://abdiinsani.unram.ac.id/index.php/jurnal/article/view/1660},
	doi = {10.29303/abdiinsani.v11i2.1660},
	abstract = {Complex technological advances in the current era of globalization have had an impact on various aspects of human life, one of which is the business world. Technology has created a new lifestyle for modern humans such as online shopping. This change in shopping style has a direct impact on MSMEs (Micro, Small and Medium Enterprises), which requires them to change their mindset and adapt to technological developments. MSMEs must innovate and improve to keep up with technological developments, so that the businesses they run can survive and develop for the better. Therefore, in order to help these MSMEs, Community Service and Assistance activities are carried out in the Rembang district area to help local MSMEs adapt to technological developments and develop their businesses, especially in the field of product marketing. This assistance focuses on increasing competitiveness as well as implementing E-commerce in Micro, Small and Medium Enterprises in the digital era. The methods applied are observation, interviews, analysis of existing conditions, Emergence of E-Commerce Solutions, E-Commerce Creation, E-Commerce usage assistance and evaluation. By applying some of these methods, it produces outcomes that can help MSMEs in digital marketing such as expanding market share and can increase high competitiveness so that it is hoped that sales turnover will increase.},
	language = {en},
	number = {2},
	urldate = {2026-06-17},
	journal = {Jurnal Abdi Insani},
	author = {Hanantyo, Burhanuddin and Sari, Nita and Farikhah, Izzah and Maulana, Reza and Maulana, Farid and Eka, Aditya},
	month = jun,
	year = {2024},
	keywords = {E-Commerce, UMKM, Web-Based Development},
	pages = {2086--2098},
	file = {Full Text PDF:/home/adi/Zotero/storage/P436UEAV/Hanantyo et al. - 2024 - Pengembangan Platform E-Commerce Berbasis Web Dalam Rangka Meningkatkan Daya Saing Umkm Kabupaten Re.pdf:application/pdf},
}

@article{wahyudi_analysis_2026,
	title = {Analysis of {E}-{Commerce} {Applications} {Using} the {System} {Usability} {Scale} ({SUS}) {Approach}},
	volume = {20},
	copyright = {Copyright (c) 2026 Tri Wahyudi, Gunawan Budi  Sulistyo, Nani  Purwati, Noor  Hasan},
	issn = {2615-224X},
	url = {https://publikasi.teknokrat.ac.id/index.php/teknoinfo/article/view/820},
	doi = {10.33365/teknoinfo.v20i1.820},
	abstract = {This study aims to measure the level of satisfaction and effectiveness of the application, as well as the obstacles encountered, using the System Usability Scale (SUS) approach. The research employs a quantitative method with a questionnaire based on the System Usability Scale (SUS) to assess application usability. The population consists of Generation Z, with a sample of 411 respondents selected using cluster disproportionate random sampling. Data were analyzed to calculate the SUS score (0–100) and interpreted using the adjective scale. This study compares the usability of three e-commerce applications: Shopee, Tokopedia, and Lazada. The results indicate that the usability scores of the three e-commerce applications are relatively close: Shopee (90.06), Tokopedia (91.98), and Lazada (88.42). Based on gender, females prefer Shopee, while males favor Tokopedia and Lazada. In terms of age, the 20–24 age group is more dominant than the 15–19 age group. Meanwhile, based on occupation, students tend to use Lazada, whereas private employees prefer Shopee and Tokopedia. Shopee and Tokopedia demonstrate optimal performance, while Lazada has development potential, particularly for private employees and users aged 15–19. Further research is recommended to deepen the analysis of Lazada and include other regions and age groups for broader results.},
	language = {en},
	number = {1},
	urldate = {2026-06-17},
	journal = {Jurnal Teknoinfo},
	author = {Wahyudi, Tri and Sulistyo, Gunawan Budi and Purwati, Nani and Hasan, Noor},
	month = jan,
	year = {2026},
	keywords = {E-commerce, Generation Z, System Usability Scale (SUS), Usability, User Satisfaction},
	pages = {57--65},
	file = {Full Text PDF:/home/adi/Zotero/storage/VDDLAMGS/Wahyudi et al. - 2026 - Analysis of E-Commerce Applications Using the System Usability Scale (SUS) Approach.pdf:application/pdf},
}

