@article{widyawati_pengembangan_2026,
	title = {Pengembangan {Media} {Pembelajaran} {Berbasis} {Linktree} {Pada} {Mata} {Kuliah} {Pengantar} {Ilmu} {Kependidikan}},
	volume = {6},
	copyright = {Copyright (c) 2026 Lambda: Jurnal Ilmiah Pendidikan MIPA dan Aplikasinya},
	issn = {2809-4409},
	url = {https://ejournal.baleliterasi.org/index.php/lambda/article/view/2604},
	doi = {10.58218/lambda.v6i1.2604},
	abstract = {This study aims to develop a Linktree-based learning media for the Introduction to Education course that is valid and practical. This research employed a Research and Development (R\&amp;D) method using the ADDIE model, which consists of Analyze, Design, Develop, Implement, and Evaluate stages. In the analysis phase, a need assessment was conducted to identify students’ needs for technology-based learning media. The results indicated that most students require learning media that are flexible, interactive, and accessible online. The developed product is a digital Linktree platform containing various learning features such as brainstorming, videos, materials, motivation, and quizzes. The validation results showed that the media achieved a score of 93.25\% (very valid), while the material validation reached 94\% (very valid). The practicality test results showed 96.3\% in the small group test and 96.2\% in the field test, both categorized as very practical. Therefore, the developed Linktree-based learning media is feasible to be used in the learning process.},
	language = {en},
	number = {1},
	urldate = {2026-08-03},
	journal = {Lambda: Jurnal Ilmiah Pendidikan MIPA dan Aplikasinya},
	author = {Widyawati, Eka and R, Nurmala},
	month = apr,
	year = {2026},
	keywords = {chemical bonding, learning outcomes, learning style, One Way Anova},
	pages = {242--253},
	file = {Full Text PDF:/home/adi/Zotero/storage/QSSJMVM6/Widyawati and R - 2026 - Pengembangan Media Pembelajaran Berbasis Linktree Pada Mata Kuliah Pengantar Ilmu Kependidikan.pdf:application/pdf},
}

@book{iswahyudi_aplikasi_2023,
